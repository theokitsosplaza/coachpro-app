generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 1. The Coach (Master Account)
model Coach {
  id         String          @id @default(cuid())
  authUserId   String?         @unique   // Supabase auth.users.id (UUID)
  email        String          @unique
  name         String?
  businessName String?
  website      String?
  isAdmin      Boolean         @default(false)   // platform admin — gates inviteCoach
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  clients   Client[]
  events    CalendarEvent[]
}

// 2. The Client (Roster)
model Client {
  id            String         @id @default(cuid())
  coachId       String
  coach         Coach          @relation(fields: [coachId], references: [id])
  authUserId    String?        @unique   // Supabase auth.users.id (UUID) — set on invite
  name          String
  goal          String
  currentPhase  String
  targetProtein Float
  targetCarbs   Float
  targetFats    Float
  email         String?
  phone         String?
  targetFiber   Int?
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  programs      Program[]
  workoutLogs   WorkoutLog[]   
  checkIns      CheckIn[]
  macroHistory  MacroHistory[]
}

// 3. The Program (The Blueprint)
model Program {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  mesocycleLength Int      
  createdAt       DateTime @default(now())
}

// 4. Execution Logging 
model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  splitType   String   
  workoutData String   
  notes       String?  
}

// 5. The Check-In 
model CheckIn {
  id            String   @id @default(cuid())
  clientId      String
  date          DateTime @default(now())
  
  weight        Float
  sleepScore    Int      
  fatigueScore  Int      
  
  loggedProtein Int
  loggedCarbs   Int
  loggedFats    Int

  // Client's own words on how the week went — the core qualitative signal.
  // NOT NULL; empty-string default backfills pre-existing rows and lets coach-
  // side / seed writes omit it. Non-empty is enforced at the app layer for the
  // client check-in form (see lib/check-in-validation.ts).
  clientReflection String @default("")

  aiSynthesis   String?
  status        String   @default("Pending")
  cycleAffected Boolean  @default(false)

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 6. Macro Versioning 
model MacroHistory {
  id           String   @id @default(cuid())
  clientId     String
  protein      Int
  carbs        Int
  fats         Int
  changeReason String?  
  changedAt    DateTime @default(now())

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 7. Calendar Events 
model CalendarEvent {
  id        String   @id @default(cuid())
  coachId   String
  title     String
  eventType String   
  startTime DateTime
  endTime   DateTime

  coach     Coach    @relation(fields: [coachId], references: [id])
}