generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 1. The Coach (Master Account)
model Coach {
  id         String          @id @default(cuid())
  authUserId   String?         @unique   // Supabase auth.users.id (UUID)
  email        String          @unique
  name         String?
  businessName String?
  website      String?
  isAdmin      Boolean         @default(false)   // platform admin — gates inviteCoach
  // Per-coach client questionnaire definitions (CoachQuestion[] — see
  // lib/questionnaire.ts). null ⇒ TS DEFAULT_QUESTIONS. Column added to prod
  // via prisma/add-questionnaire-columns.sql (surgical db execute, no push).
  questionnaire Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  clients   Client[]
  events    CalendarEvent[]
}

// 2. The Client (Roster)
model Client {
  id            String         @id @default(cuid())
  coachId       String
  coach         Coach          @relation(fields: [coachId], references: [id])
  authUserId    String?        @unique   // Supabase auth.users.id (UUID) — set on invite
  name          String
  goal          String
  currentPhase  String
  targetProtein Float
  targetCarbs   Float
  targetFats    Float
  email         String?
  phone         String?
  // Client-facing output language, ISO 639-1 ("en", "el"). Plain String +
  // default, mirroring CheckIn.status — the allow-list lives in TS
  // (lib/i18n/languages.ts), not a Prisma enum. @default backfills the
  // existing prod rows on db push (NOT NULL without it would fail).
  language      String         @default("en")
  // Coach-recorded onboarding answers (AnswerSet snapshot — see
  // lib/questionnaire.ts). null ⇒ no background context for the AI. Column
  // added to prod via prisma/add-questionnaire-columns.sql.
  questionnaireAnswers Json?
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  programs      Program[]
  workoutLogs   WorkoutLog[]
  checkIns      CheckIn[]
  macroHistory  MacroHistory[]
  questionnaireChanges QuestionnaireChange[]
}

// Audit trail for coach-accepted AI profile-update proposals — the
// MacroHistory pattern. Deliberately SELF-CONTAINED (labels, values, evidence
// all snapshotted) and with NO FK to CheckIn: deleting a check-in, clearing a
// change note, or editing a question must never erase or orphan the audit of
// a change the coach accepted. Table added to prod via
// prisma/add-proposal-tables.sql.
model QuestionnaireChange {
  id            String   @id @default(cuid())
  clientId      String
  checkInId     String   // plain string on purpose — see above
  checkInDate   DateTime
  questionId    String
  questionLabel String
  oldValue      String
  newValue      String
  evidence      String   // the quoted client/coach words that triggered it
  source        String   // 'reflection' | 'changeNote'
  changedAt     DateTime @default(now())

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// 3. The Program (The Blueprint)
model Program {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  mesocycleLength Int      
  createdAt       DateTime @default(now())
}

// 4. Execution Logging 
model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  splitType   String   
  workoutData String   
  notes       String?  
}

// 5. The Check-In 
model CheckIn {
  id            String   @id @default(cuid())
  clientId      String
  date          DateTime @default(now())
  
  weight        Float
  sleepScore    Int      
  fatigueScore  Int      
  
  loggedProtein Int
  loggedCarbs   Int
  loggedFats    Int

  // Client's own words on how the week went — the core qualitative signal.
  // NOT NULL; empty-string default backfills pre-existing rows and lets coach-
  // side / seed writes omit it. Non-empty is enforced at the app layer for the
  // client check-in form (see lib/check-in-validation.ts).
  clientReflection String @default("")

  // Coach-recorded "did anything change this week?" note (new job, injury,
  // holiday, stopped a supplement). Optional per check-in; null = nothing
  // recorded. Feeds coachSummary + attention flag context ONLY — never the
  // engine, never clientMessage. Column added to prod via
  // prisma/add-change-note-column.sql (surgical db execute, no push).
  changeNote    String?

  // Resolutions of AI-proposed profile updates for THIS check-in:
  // [{ questionId, resolution: 'accepted'|'dismissed'|'expired', at }].
  // Keyed per check-in so a dismissal survives edit→regenerate cycles (the
  // edit action nulls aiSynthesis but never touches this column), while a
  // LATER check-in with fresh evidence may propose the same question again.
  // Column added to prod via prisma/add-proposal-tables.sql.
  proposalResolutions Json?

  aiSynthesis   String?
  status        String   @default("Pending")
  cycleAffected Boolean  @default(false)

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 6. Macro Versioning 
model MacroHistory {
  id           String   @id @default(cuid())
  clientId     String
  protein      Int
  carbs        Int
  fats         Int
  changeReason String?  
  changedAt    DateTime @default(now())

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 7. Calendar Events 
model CalendarEvent {
  id        String   @id @default(cuid())
  coachId   String
  title     String
  eventType String   
  startTime DateTime
  endTime   DateTime

  coach     Coach    @relation(fields: [coachId], references: [id])
}